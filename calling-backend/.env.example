DATABASE_URL="file:./dev.db"
PORT=3000

# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=""
JWT_EXPIRES_IN="7d"

# Absolute path to the attendance server's SQLite DB (read-only, for sync/reconcile)
ATTENDEASE_DB_PATH="../attendance-server/database/attendance.db"
ATTENDEASE_BASE_URL="http://127.0.0.1:6061"

# Shared secret for attendance server <-> calling backend internal webhooks (same value on both sides)
INTERNAL_TOKEN=""
# Shared JWT secret for unified login (same value as JWT_SHARED_SECRET in attendance-server/.env)
JWT_SHARED_SECRET=""

# First admin account, used once by: npm run migrate:bootstrap-host
BOOTSTRAP_HOST_USERNAME=""
BOOTSTRAP_HOST_PASSWORD=""

# Password for the "superadmin" account created by prisma/seed.ts (choose a strong one)
SUPERADMIN_PASSWORD=""
