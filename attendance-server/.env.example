# Copy to .env and fill in. Never commit the real .env.

# Flask session signing key. Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Public URL people use to reach this server (tunnel / domain)
PUBLIC_BASE_URL=https://attendance.example.com
PORT=6061
APP_ENV=development

# Calling backend (see ../calling-backend)
CALLING_BACKEND_BASE_URL=http://127.0.0.1:3000
CALLING_BACKEND_WEBHOOK_URL=http://127.0.0.1:3000/internal/attendease-event
# Must equal INTERNAL_TOKEN in calling-backend/.env
INTERNAL_TOKEN=
# Must equal JWT_SHARED_SECRET in calling-backend/.env
JWT_SHARED_SECRET=
# Optional: path to the calling backend SQLite file (defaults to ../calling-backend/prisma/dev.db)
CALLING_BACKEND_DB_PATH=

# Optional Google Sheets mirror. Put the service-account key next to app.py as google_sheets_key.json
GOOGLE_SHEET_ID=
CENTRE_B_GOOGLE_SHEET_ID=
